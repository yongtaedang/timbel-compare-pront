# 이 파일은 전체 env 키의 템플릿(git 추적됨). 실제 값은 환경별 파일에 둔다:
#   .env.dev(개발) · .env.prd(운영) — npm 빌드 스크립트가 dotenv-cli로 로드한다.
# 정적 export 앱이라 NEXT_PUBLIC_* 값은 빌드 시 클라이언트 번들에 그대로 인라인되어
# 브라우저에 노출된다 — 여기엔 시크릿을 두지 않는다.

# timbel-compare-api 베이스 URL. 브라우저가 직접 호출한다(src/lib/api.ts).
# API 쪽 CORS_ALLOWED_ORIGINS에 이 프론트 주소가 들어 있어야 한다.
NEXT_PUBLIC_API_URL=http://localhost:8080

# API 라우트 접두사. API의 API_PREFIX와 같아야 한다.
NEXT_PUBLIC_API_PREFIX=/api/compare/v1

# 워커 수 입력칸의 기본값. 비우면 브라우저가 보는 논리 코어 수를 쓴다.
NEXT_PUBLIC_DEFAULT_WORKERS=
