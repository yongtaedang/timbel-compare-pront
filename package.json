{
  "name": "timbel-compare",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:dev": "dotenv -e .env.dev -- next dev",
    "dev:prd": "dotenv -e .env.prd -- next dev",
    "build": "next build",
    "build:dev": "dotenv -e .env.dev -- next build",
    "build:prd": "dotenv -e .env.prd -- next build",
    "test": "vitest run",
    "serve:out": "serve out -l 3000 --no-clipboard",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
